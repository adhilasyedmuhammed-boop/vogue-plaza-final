# MongoDB connection for local development
# Uncomment the setting you want to use and copy to .env

# Use a local MongoDB instance:
# MONGO_URI=mongodb://127.0.0.1:27017/vogue_plaza

# Use MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vogue_plaza?retryWrites=true&w=majority
